// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATOR
  PURCHASING_OFFICER
  STORE_EMPLOYEE
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role     @default(STORE_EMPLOYEE)
  /// Store assignment. A STORE_EMPLOYEE is bound to exactly one store; a MANAGER and an
  /// ADMINISTRATOR are organization-wide and leave this null. A full Store model arrives
  /// with the master-data ticket; for now this holds the store's identifier.
  storeId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A physical store/branch. Code and name are maintained by an administrator and referenced by
/// later documents (purchase orders, receipts, sales). Code is unique across the organization.
model Store {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A supplier that purchase orders reference. Code is unique; contact is free-form (optional).
model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  contact   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Whether an audited action succeeded or was refused.
enum AuditOutcome {
  success
  failure
}

/// An append-only audit record for a sensitive write: who acted, on what entity, and the outcome.
/// Access is permission-restricted at the API. There is no edit or delete route.
model AuditRecord {
  id        String       @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  outcome   AuditOutcome
  createdAt DateTime     @default(now())

  @@index([entity, createdAt])
}

/// A product in the catalogue that purchasing, receiving, sales, and reporting all depend on.
/// SKU is unique across the organization and immutable once a transaction references the product
/// (`referenced` is set true by the first document that points at it; later tickets flip it). A
/// product can be deactivated (`active = false`): it stays searchable in historical lookups but
/// the API refuses to add an inactive product to a new document. `sellingPrice` is a whole number
/// of the smallest currency unit (satang); it is never negative (enforced at the contract).
model Product {
  id           String       @id @default(cuid())
  sku          String       @unique
  name         String
  category     String
  unit         String
  /// Selling price in satang (1 THB = 100). Whole, non-negative; validated at the contract.
  sellingPrice Int
  active       Boolean      @default(true)
  /// True once any transaction (purchase order, receipt, sale) references this product. While
  /// true the SKU may not change. Set by later transaction tickets; defaults false at creation.
  referenced   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  stockLevels  StockLevel[]
}

/// Per-store stock for a product: the on-hand quantity and the reorder threshold at which the
/// store should restock. Both are whole, non-negative (validated at the contract). One row per
/// (product, store); the pair is unique so a product has at most one threshold per store.
model StockLevel {
  id               String   @id @default(cuid())
  productId        String
  storeId          String
  /// On-hand quantity. Whole, non-negative.
  quantity         Int      @default(0)
  /// Reorder threshold for this product at this store. Whole, non-negative.
  reorderThreshold Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@index([storeId])
}
