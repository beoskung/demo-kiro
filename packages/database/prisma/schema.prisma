// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATOR
  PURCHASING_OFFICER
  STORE_EMPLOYEE
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role     @default(STORE_EMPLOYEE)
  /// Store assignment. A STORE_EMPLOYEE is bound to exactly one store; a MANAGER and an
  /// ADMINISTRATOR are organization-wide and leave this null. A full Store model arrives
  /// with the master-data ticket; for now this holds the store's identifier.
  storeId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A physical store/branch. Code and name are maintained by an administrator and referenced by
/// later documents (purchase orders, receipts, sales). Code is unique across the organization.
model Store {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A supplier that purchase orders reference. Code is unique; contact is free-form (optional).
model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  contact   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Whether an audited action succeeded or was refused.
enum AuditOutcome {
  success
  failure
}

/// An append-only audit record for a sensitive write: who acted, on what entity, and the outcome.
/// Access is permission-restricted at the API. There is no edit or delete route.
model AuditRecord {
  id        String       @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  outcome   AuditOutcome
  createdAt DateTime     @default(now())

  @@index([entity, createdAt])
}

/// A product in the catalogue that purchasing, receiving, sales, and reporting all depend on.
/// SKU is unique across the organization and immutable once a transaction references the product
/// (`referenced` is set true by the first document that points at it; later tickets flip it). A
/// product can be deactivated (`active = false`): it stays searchable in historical lookups but
/// the API refuses to add an inactive product to a new document. `sellingPrice` is a whole number
/// of the smallest currency unit (satang); it is never negative (enforced at the contract).
model Product {
  id           String       @id @default(cuid())
  sku          String       @unique
  name         String
  category     String
  unit         String
  /// Selling price in satang (1 THB = 100). Whole, non-negative; validated at the contract.
  sellingPrice Int
  active       Boolean      @default(true)
  /// True once any transaction (purchase order, receipt, sale) references this product. While
  /// true the SKU may not change. Set by later transaction tickets; defaults false at creation.
  referenced   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  stockLevels  StockLevel[]
  movements    StockMovement[]
}

/// Per-store stock for a product: the on-hand quantity and the reorder threshold at which the
/// store should restock. Both are whole, non-negative (validated at the contract). One row per
/// (product, store); the pair is unique so a product has at most one threshold per store.
///
/// `quantity` is the stored running balance (INV-03): it equals the opening balance plus every
/// successful movement, and the ledger (`StockMovement`) records each change. The balance may
/// reach 0 but is never driven negative. A matching `StockMovement` row is always written in the
/// same transaction as a balance change so the two can never disagree.
model StockLevel {
  id               String   @id @default(cuid())
  productId        String
  storeId          String
  /// On-hand running balance. Whole, non-negative.
  quantity         Int      @default(0)
  /// Reorder threshold for this product at this store. Whole, non-negative.
  reorderThreshold Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@index([storeId])
}

/// What kind of change a movement records. A RECEIPT increases stock (goods received against a
/// purchase order), a SALE decreases it (store sale), and an ADJUSTMENT is a manual manager
/// correction in either direction. The set grows only if the spec adds movement kinds.
enum MovementType {
  RECEIPT
  SALE
  ADJUSTMENT
}

/// The immutable stock-movement ledger (INV-02). Every stock increase or decrease appends exactly
/// one row capturing the product, store, signed quantity delta, the balance before and after, the
/// movement type, the source document that caused it, the actor, and the timestamp. Rows are
/// append-only: there is no edit or delete route, so any balance is fully traceable and
/// tamper-evident (NFR-03). `balanceAfter` always equals `balanceBefore + delta` and is never
/// negative, enforced by the handler that writes the balance and this row in one transaction.
model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  storeId       String
  /// Signed change applied to the balance: positive for an increase, negative for a decrease.
  delta         Int
  /// The running balance immediately before this movement.
  balanceBefore Int
  /// The running balance immediately after this movement (= balanceBefore + delta, never < 0).
  balanceAfter  Int
  type          MovementType
  /// The document that caused the movement (e.g. a goods-receipt or sale number). Free-form so
  /// later tickets can reference their own document numbers without a schema change.
  sourceDocument String
  /// The user who performed the action (User.id). Kept as an identifier for the audit trail.
  actorId       String
  createdAt     DateTime     @default(now())
  product       Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, storeId, createdAt])
  @@index([storeId, createdAt])
  @@index([type, createdAt])
}

/// A monotonically increasing counter per document prefix, used to mint unique document numbers
/// (§4.3). Receipts and sales each take a prefix (e.g. `GR`, `SA`) and call the generator, which
/// atomically increments the counter inside a transaction and formats `<PREFIX>-<zero-padded>`.
/// The unique `prefix` plus the atomic increment guarantees no two callers ever get the same
/// number, even under concurrency.
model DocumentSequence {
  prefix    String   @id
  /// The last number handed out for this prefix. The next call returns `value + 1`.
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  CANCELLED
}

/// A purchase order: the document a purchasing officer prepares to order stock from a supplier.
/// PO-01 (this ticket) lands draft creation and editing. Later tickets add submission, goods
/// receipt, and cancellation. `documentNumber` is unique and generated on creation (PO-00001, etc).
/// A draft names one supplier, one destination store, an expected receipt date, and at least one
/// line with positive whole `orderedQuantity` and non-negative `unitPrice` (satang). The same SKU
/// may not appear twice in one order (enforced at the contract and API).
model PurchaseOrder {
  id                   String              @id @default(cuid())
  documentNumber       String              @unique
  supplierId           String
  destinationStoreId   String
  expectedReceiptDate  DateTime
  status               PurchaseOrderStatus @default(DRAFT)
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  lines                PurchaseOrderLine[]
}

/// One line of a purchase order: the product, ordered quantity (whole, positive), and unit price
/// (satang, non-negative). A line is deleted when the draft is edited; there is no PATCH route.
model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  orderedQuantity Int
  /// Purchase unit price in satang (1 THB = 100). Whole, non-negative.
  unitPrice       Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}
